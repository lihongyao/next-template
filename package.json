{
  "name": "nextjs-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "cross-env app=${app:-afun} env=${env:-dev} dotenv -e env/.env.${app-afun}.${env-dev} -- tsx scripts/pre-setup/index.ts",
    "dev": "dotenv -e env/.env.${app-afun}.${env-dev} -- next dev --turbopack",
    "prebuild": "cross-env app=${app:-afun} env=${env:-dev} dotenv -e env/.env.${app-afun}.${env-dev} -- tsx scripts/pre-setup/index.ts",
    "build": "dotenv -e env/.env.${app-afun}.${env-dev} -- next build --turbopack",
    "start": "next start",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "------": "-----",
    "i18n": "tsx scripts/excel2json/index.ts",
    "convert:theme": "tsx scripts/convert-css-vars/index.js",
    "convert:theme-tw": "tsx scripts/convert-css-vars/index.js --tw",
    "gen-figma-variables": "tsx scripts/gen-figma-variables/index.ts",
    "gen-svg": "tsx scripts/gen-svg/index.ts"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxlint --fix",
      "prettier --write"
    ],
    "*.{css,scss,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "ahooks": "^3.9.6",
    "class-variance-authority": "^0.7.1",
    "file-saver": "^2.0.5",
    "framer-motion": "^12.36.0",
    "html2canvas-pro": "^2.0.2",
    "immer": "^11.1.4",
    "lodash": "^4.17.23",
    "next": "16.1.4",
    "next-intl": "^4.8.3",
    "next-scroll-restorer": "^0.11.0",
    "next-view-transitions": "^0.3.5",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.2",
    "react-qr-code": "^2.0.18",
    "swiper": "^12.1.2",
    "tailwind-merge": "^3.5.0",
    "ua-parser-js": "^2.0.9",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.4",
    "@commitlint/config-conventional": "^20.4.4",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@svgr/plugin-svgo": "^8.1.0",
    "@tailwindcss/postcss": "^4.2.1",
    "@trivago/prettier-plugin-sort-imports": "^6.0.2",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "1.0.0",
    "chalk": "^5.6.2",
    "chokidar": "^5.0.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.3",
    "oxlint": "^1.55.0",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vconsole": "^3.15.1",
    "xlsx": "^0.18.5"
  }
}
